# UV / Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Type checker / lint caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# IDE
.idea/
.vscode/

# Machine-dependent, never committed (built by <module>/scripts/dm_link.py)
/resources/
/outputs/

# Executed notebook copies
/notebooks/*.executed.ipynb

# NOTE: .docs/ is deliberately NOT ignored -- it is the record of
# the work (progress.md, figures, latex-draft, promoted runs).

# Experiment tracking caches
wandb/

# OS
.DS_Store

# Project-specific
# Unpacked reference template, rebuildable from the zip
/globalopenhack/
# graphify working directory; the exported graph covers the unpacked
# template too, so it is local-only
/graphify-out/
# Panel runtime output
*.log
